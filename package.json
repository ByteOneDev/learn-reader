{
  "name": "learn-reader",
  "productName": "Learn",
  "version": "0.1.0",
  "description": "Lecteur RSS, articles, livres et notes — inspiré de Reeder, pensé pour la recherche.",
  "main": "./out/main/index.js",
  "author": "ByteOneDev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check-feeds": "node --no-warnings --experimental-strip-types scripts/check-feeds.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.14",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "framer-motion": "14.7.1",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  }
}
