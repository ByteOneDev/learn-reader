{
  "name": "learn-reader",
  "productName": "Learn",
  "version": "0.15.1",
  "description": "Lecteur RSS, articles, livres et notes — inspiré de Reeder, pensé pour la recherche.",
  "main": "./out/main/index.js",
  "author": "ByteOneDev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p obsidian-plugin/tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check-feeds": "node --no-warnings --experimental-strip-types scripts/check-feeds.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "plugin:build": "node obsidian-plugin/build.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "linkedom": "0.18.15",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "@xyflow/react": "^12.12.1",
    "dompurify": "3.4.17",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "framer-motion": "14.9.0",
    "lucide-react": "1.67.0",
    "obsidian": "^1.14.4",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "0.19.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  }
}
