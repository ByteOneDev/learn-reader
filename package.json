{
  "name": "learn-reader",
  "productName": "Learn",
  "version": "0.1.0",
  "description": "Lecteur RSS, articles, livres et notes — inspiré de Reeder, pensé pour la recherche.",
  "main": "./out/main/index.js",
  "author": "ByteOneDev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check-feeds": "node --no-warnings --experimental-strip-types scripts/check-feeds.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.7.0",
    "linkedom": "0.18.12",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.17",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "framer-motion": "12.23.24",
    "lucide-react": "0.548.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zustand": "5.0.8"
  },
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  }
}
